@using System.Linq
@model IEnumerable<tiendaDeportiva.Models.Producto>

@{
    ViewBag.Title = "Productos";
}

<div class="container mt-4">
    <div class="row" style="margin-bottom: 20px;">
        <div class="col-md-8">
            <h2 style="margin-top: 0;">Productos</h2>
            <p class="text-muted">Administra el catálogo de productos disponibles en el sistema.</p>
        </div>
        <div class="col-md-4 text-right">
            @Html.ActionLink("Nuevo producto", "Create", null, new { @class = "btn btn-primary" })
            @Html.ActionLink("Ver carrito", "Index", "Carrito", null, new { @class = "btn btn-success" })
        </div>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">
            @TempData["Mensaje"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="panel panel-default">
        <div class="panel-heading">
            <strong>Listado de productos</strong>
        </div>

        <div class="table-responsive">
            <table class="table table-hover table-striped table-bordered" style="margin-bottom: 0;">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Nombre)</th>
                        <th>@Html.DisplayNameFor(model => model.Descripcion)</th>
                        <th>@Html.DisplayNameFor(model => model.Precio)</th>
                        <th>@Html.DisplayNameFor(model => model.Stock)</th>
                        <th>@Html.DisplayNameFor(model => model.Categoria)</th>
                        <th>@Html.DisplayNameFor(model => model.Activo)</th>
                        <th class="text-center" style="width: 280px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@Html.DisplayFor(modelItem => item.Nombre)</td>
                                <td>@Html.DisplayFor(modelItem => item.Descripcion)</td>
                                <td>@item.Precio.ToString("C")</td>
                                <td>@Html.DisplayFor(modelItem => item.Stock)</td>
                                <td>@item.Categoria.ToString()</td>
                                <td>
                                    @if (item.Activo)
                                    {
                                        <span class="label label-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="label label-default">Inactivo</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @Html.ActionLink("Editar", "Edit", new { id = item.Id }, new { @class = "btn btn-xs btn-warning" })
                                    @Html.ActionLink("Ver", "Details", new { id = item.Id }, new { @class = "btn btn-xs btn-info" })
                                    @Html.ActionLink("Eliminar", "Delete", new { id = item.Id }, new { @class = "btn btn-xs btn-danger" })

                                    @if (item.Activo && item.Stock > 0)
                                    {
                                        using (Html.BeginForm("Agregar", "Carrito", FormMethod.Post, new { style = "display:inline-block; margin-left:4px;" }))
                                        {
                                            @Html.Hidden("idProducto", item.Id)
                                            @Html.Hidden("cantidad", 1)
                                            <button type="submit" class="btn btn-xs btn-success">Agregar</button>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-danger" style="margin-left: 5px;">Sin stock</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted" style="padding: 20px;">
                                No hay productos registrados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
