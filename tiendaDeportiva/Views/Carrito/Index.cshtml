@model tiendaDeportiva.Models.Carrito

@{
    ViewBag.Title = "Carrito";
}

<h2>Carrito de Compras</h2>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (Model == null || !Model.Items.Any())
{
    <div class="alert alert-info">
        El carrito está vacío.
    </div>

    <p>
        @Html.ActionLink("Seguir comprando", "Index", "Productoes", null, new { @class = "btn btn-primary" })
    </p>
}
else
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Producto</th>
                <th>Precio</th>
                <th style="width:180px;">Cantidad</th>
                <th>Subtotal</th>
                <th style="width:120px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Nombre</td>
                    <td>@item.Precio.ToString("C")</td>
                    <td>
                        @using (Html.BeginForm("ActualizarCantidad", "Carrito", FormMethod.Post))
                        {
                            @Html.Hidden("idProducto", item.IdProducto)
                            <input type="number" name="cantidad" value="@item.Cantidad" min="1" max="@item.StockDisponible" class="form-control" style="display:inline-block; width:80px;" />
                            <button type="submit" class="btn btn-sm btn-warning">Actualizar</button>
                        }
                    </td>
                    <td>@item.Subtotal.ToString("C")</td>
                    <td>
                        @using (Html.BeginForm("Eliminar", "Carrito", FormMethod.Post))
                        {
                            @Html.Hidden("idProducto", item.IdProducto)
                            <button type="submit" class="btn btn-sm btn-danger">Quitar</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h4>Total: <strong>@Model.Total.ToString("C")</strong></h4>

    <div style="margin-top:20px;">
        @Html.ActionLink("Seguir comprando", "Index", "Productoes", null, new { @class = "btn btn-primary" })

        @using (Html.BeginForm("Vaciar", "Carrito", FormMethod.Post, new { style = "display:inline-block; margin-left:10px;" }))
        {
            <button type="submit" class="btn btn-danger">Vaciar carrito</button>
        }

        @using (Html.BeginForm("ProcesarOrden", "Carrito", FormMethod.Post, new { style = "display:inline-block; margin-left:10px;" }))
        {
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-success">Procesar orden</button>
        }
    </div>
}