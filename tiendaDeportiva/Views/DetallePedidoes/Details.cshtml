@model tiendaDeportiva.Models.DetallePedido

@{
    ViewBag.Title = "Detalle del pedido";
}

<div class="container" style="margin-top: 20px;">
    <div class="row">
        <div class="col-md-10 col-md-offset-1">
            <div class="page-header" style="margin-top: 0;">
                <h2 style="margin-top: 0;">Detalle del pedido</h2>
                <p class="text-muted">Consulta la información registrada para este detalle.</p>
            </div>

            <div class="panel panel-default">
                <div class="panel-heading">
                    <strong>Información del detalle</strong>
                </div>
                <div class="panel-body">
                    <dl class="dl-horizontal" style="margin-bottom: 0;">
                        <dt>Usuario del pedido</dt>
                        <dd>@Html.DisplayFor(model => model.Pedido.IdUsuario)</dd>

                        <dt>Producto</dt>
                        <dd>@Html.DisplayFor(model => model.Producto.Nombre)</dd>

                        <dt>@Html.DisplayNameFor(model => model.Cantidad)</dt>
                        <dd>@Html.DisplayFor(model => model.Cantidad)</dd>

                        <dt>@Html.DisplayNameFor(model => model.PrecioUnitario)</dt>
                        <dd>@Model.PrecioUnitario.ToString("C")</dd>
                    </dl>
                </div>
                <div class="panel-footer">
                    @Html.ActionLink("Editar", "Edit", new { id = Model.Id }, new { @class = "btn btn-warning btn-sm" })
                    @Html.ActionLink("Volver al listado", "Index", null, new { @class = "btn btn-default btn-sm" })
                </div>
            </div>
        </div>
    </div>
</div>
