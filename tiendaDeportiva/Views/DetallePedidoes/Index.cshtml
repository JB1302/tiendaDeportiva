@using System.Linq
@model IEnumerable<tiendaDeportiva.Models.DetallePedido>

@{
    ViewBag.Title = "Detalle de pedidos";
}

<div class="container mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-1">Detalle de pedidos</h2>
            <p class="text-muted mb-0">Consulta los productos incluidos en cada pedido.</p>
        </div>
        <div class="mt-2 mt-md-0">
            @Html.ActionLink("Nuevo detalle", "Create", null, new { @class = "btn btn-primary" })
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="thead-dark">
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.Pedido.IdUsuario)</th>
                            <th>@Html.DisplayNameFor(model => model.Producto.Nombre)</th>
                            <th>@Html.DisplayNameFor(model => model.Cantidad)</th>
                            <th>@Html.DisplayNameFor(model => model.PrecioUnitario)</th>
                            <th class="text-center" style="width: 220px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@Html.DisplayFor(modelItem => item.Pedido.IdUsuario)</td>
                                    <td>@Html.DisplayFor(modelItem => item.Producto.Nombre)</td>
                                    <td>
                                        <span class="badge badge-info px-3 py-2">
                                            @Html.DisplayFor(modelItem => item.Cantidad)
                                        </span>
                                    </td>
                                    <td>@item.PrecioUnitario.ToString("C")</td>
                                    <td class="text-center">
                                        @Html.ActionLink("Editar", "Edit", new { id = item.Id }, new { @class = "btn btn-sm btn-warning mr-1" })
                                        @Html.ActionLink("Ver", "Details", new { id = item.Id }, new { @class = "btn btn-sm btn-info mr-1 text-white" })
                                        @Html.ActionLink("Eliminar", "Delete", new { id = item.Id }, new { @class = "btn btn-sm btn-danger" })
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">No hay detalles de pedido registrados.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
