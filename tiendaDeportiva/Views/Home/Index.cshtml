@{
    ViewBag.Title = "Inicio";
}

<main class="container" style="margin-top: 30px;">
    <div class="jumbotron">
        <h1 style="margin-top: 0;">Tienda Deportiva</h1>
    </div>

    <div class="row">
        <section class="col-md-4">
            <div class="panel panel-primary">
                <div class="panel-heading">
                    <h3 class="panel-title">Productos</h3>
                </div>
                <div class="panel-body">
                    <p>
                        Administra el catálogo de productos deportivos, precios, stock,
                        categoría y estado.
                    </p>
                    <p>
                        @Html.ActionLink("Ir a productos", "Index", "Productoes", null, new { @class = "btn btn-primary" })
                    </p>
                </div>
            </div>
        </section>

        <section class="col-md-4">
            <div class="panel panel-success">
                <div class="panel-heading">
                    <h3 class="panel-title">Pedidos</h3>
                </div>
                <div class="panel-body">
                    <p>
                        Consulta y administra los pedidos realizados por los usuarios,
                        incluyendo monto total y estado.
                    </p>
                    <p>
                        @Html.ActionLink("Ir a pedidos", "Index", "Pedidoes", null, new { @class = "btn btn-success" })
                    </p>
                </div>
            </div>
        </section>

        <section class="col-md-4">
            <div class="panel panel-info">
                <div class="panel-heading">
                    <h3 class="panel-title">Detalles de pedido</h3>
                </div>
                <div class="panel-body">
                    <p>
                        Revisa los productos asociados a cada pedido, cantidades y precios
                        unitarios registrados.
                    </p>
                    <p>
                        @Html.ActionLink("Ir a detalles", "Index", "DetallePedidoes", null, new { @class = "btn btn-info" })
                    </p>
                </div>
            </div>
        </section>
    </div>
</main>