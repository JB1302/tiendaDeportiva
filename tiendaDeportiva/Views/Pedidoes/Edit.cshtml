@model tiendaDeportiva.Models.Pedido

@{
    ViewBag.Title = "Editar pedido";
}

<div class="container" style="margin-top: 20px;">
    <div class="row">
        <div class="col-md-10 col-md-offset-1">
            <div class="page-header" style="margin-top: 0;">
                <h2 style="margin-top: 0;">Editar pedido</h2>
                <p class="text-muted">Actualiza la información del pedido seleccionado.</p>
            </div>

            <div class="panel panel-default">
                <div class="panel-heading">
                    <strong>Formulario de edición</strong>
                </div>
                <div class="panel-body">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-horizontal">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            @Html.HiddenFor(model => model.Id)

                            <div class="form-group">
                                @Html.LabelFor(model => model.Fecha, htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.Fecha, new { htmlAttributes = new { @class = "form-control" } })
                                    @Html.ValidationMessageFor(model => model.Fecha, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.IdUsuario, htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.IdUsuario, new { htmlAttributes = new { @class = "form-control", @placeholder = "Ingrese el usuario" } })
                                    @Html.ValidationMessageFor(model => model.IdUsuario, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.MontoTotal, htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.EditorFor(model => model.MontoTotal, new { htmlAttributes = new { @class = "form-control", @placeholder = "Ingrese el monto total" } })
                                    @Html.ValidationMessageFor(model => model.MontoTotal, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.Estado, htmlAttributes: new { @class = "control-label col-md-3" })
                                <div class="col-md-9">
                                    @Html.EnumDropDownListFor(model => model.Estado, htmlAttributes: new { @class = "form-control" })
                                    @Html.ValidationMessageFor(model => model.Estado, "", new { @class = "text-danger" })
                                </div>
                            </div>

                            <hr />

                            <div class="form-group" style="margin-bottom: 0;">
                                <div class="col-md-offset-3 col-md-9">
                                    <input type="submit" value="Guardar cambios" class="btn btn-primary" />
                                    @Html.ActionLink("Volver al listado", "Index", null, new { @class = "btn btn-default" })
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
